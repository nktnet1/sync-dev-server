{
  "name": "sync-dev-server",
  "author": "Khiet Tam Nguyen",
  "license": "MIT",
  "type": "module",
  "description": "Starts a server before your tests and stops on completion. Inspired by jest-puppeteer's subpackage jest-dev-server. Setup and teardown operations are fully synchronous.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/sync-dev-server"
  },
  "version": "1.1.3",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "start": "tsx tests/app/server1",
    "start2": "tsx tests/app/server2",
    "test": "vitest run",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "nodejs",
    "sync",
    "synchronous",
    "jest",
    "server",
    "development",
    "jest-dev-server",
    "automatic",
    "start",
    "stop",
    "kill",
    "kill-sync",
    "testing",
    "http",
    "localhost",
    "comp1531"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/command-exists": "^1.2.3",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/node-netstat": "^1.8.4",
    "@vitest/coverage-v8": "4.1.10",
    "express": "^5.2.1",
    "globals": "^17.7.0",
    "lefthook": "2.1.10",
    "morgan": "^1.11.0",
    "sync-request-curl": "^4.0.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "command-exists": "^1.2.9",
    "dns-lookup-sync": "^1.0.3",
    "kill-sync": "^1.0.4",
    "node-netstat": "^1.9.0",
    "slync": "^1.0.3"
  },
  "packageManager": "pnpm@11.17.0",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
